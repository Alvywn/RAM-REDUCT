//
// Dialog resources
//
IDD_MAIN DIALOGEX 0, 0, 232, 262
STYLE WS_POPUPWINDOW | WS_MINIMIZEBOX | WS_CAPTION | DS_SHELLFONT | DS_MODALFRAME | NOT WS_VISIBLE
CAPTION APP_NAME_W
MENU IDM_MAIN
FONT 8, "Ms Shell Dlg"
{
	CONTROL			"", IDC_LISTVIEW, WC_LISTVIEW, NOT WS_BORDER | LVS_SHOWSELALWAYS | LVS_REPORT | LVS_NOCOLUMNHEADER, 8, 8, 216, 222
	PUSHBUTTON		"", IDC_CLEAN, 8, 238, 216, 16, BS_SPLITBUTTON | BS_CENTER | BS_VCENTER
}

IDD_SETTINGS_CONTAINER DIALOGEX 0, 0, 368, 222
STYLE WS_POPUPWINDOW | WS_CAPTION | DS_SHELLFONT | DS_MODALFRAME
CAPTION L"Settings"
FONT 8, "Ms Shell Dlg"
{
	LISTBOX			IDC_SETTINGS_NAV, 8, 8, 86, 184, LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_BORDER | WS_VSCROLL | WS_TABSTOP
	PUSHBUTTON		L"Reset", IDC_SETTINGS_RESET, 8, 200, 56, 14
	PUSHBUTTON		L"Open Config", IDC_OPENCONFIG_BTN, 70, 200, 68, 14
	DEFPUSHBUTTON	L"Close", IDC_SETTINGS_CLOSE, 304, 200, 56, 14
}

IDD_CONFIRM DIALOGEX 0, 0, 264, 126
STYLE WS_POPUPWINDOW | WS_CAPTION | DS_SHELLFONT | DS_MODALFRAME | DS_CENTER
CAPTION APP_NAME_W
FONT 8, "Ms Shell Dlg"
{
	LTEXT			"", IDC_CONFIRM_TEXT, 10, 10, 244, 72
	AUTOCHECKBOX	L"Do not ask again", IDC_CONFIRM_DONTASK, 10, 88, 244, 10
	DEFPUSHBUTTON	L"Yes", IDYES, 144, 104, 52, 14
	PUSHBUTTON		L"No", IDNO, 202, 104, 52, 14
}


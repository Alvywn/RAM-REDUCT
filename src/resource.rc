//
// Icon resources
//
IDI_MAIN		ICON		"res\\100.ico"

//
// Manifest resource
//
1			RT_MANIFEST		"res\\manifest.xml"

//
// Version Information resources (040904B0 Unicode so Windows Explorer, Task Manager & Startup detect app metadata)
//
VS_VERSION_INFO VERSIONINFO
FILEVERSION		APP_VERSION_RES
PRODUCTVERSION	APP_VERSION_RES
FILEFLAGSMASK	0x3fL
FILEFLAGS		0x0L
FILEOS			VOS_NT_WINDOWS32
FILETYPE		VFT_APP
FILESUBTYPE		VFT2_UNKNOWN
{
	BLOCK "StringFileInfo"
	{
		BLOCK "040904B0"
		{
			VALUE "Comments", APP_COMMENT "\0"
			VALUE "CompanyName", APP_AUTHOR "\0"
			VALUE "FileDescription", APP_NAME "\0"
			VALUE "FileVersion", APP_VERSION "\0"
			VALUE "InternalName", APP_NAME_SHORT "\0"
			VALUE "LegalCopyright", APP_COPYRIGHT "\0"
			VALUE "OriginalFilename", "ramreduct.exe\0"
			VALUE "ProductName", APP_NAME "\0"
			VALUE "ProductVersion", APP_VERSION "\0"
		}
	}
	BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x0409, 1200
	}
}
